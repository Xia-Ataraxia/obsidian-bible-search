{
	"name": "obsidian-bible-search",
	"version": "1.3.11",
	"description": "Search Korean/English Bible verses and insert with configurable template format.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:build": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src test",
		"lint:fix": "eslint src test --fix",
		"test": "vitest run",
		"ci": "pnpm run build && pnpm run lint && pnpm run test",
		"prepare": "husky",
		"version": "node scripts/version.mjs",
		"postversion": "git push && git push --tags",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major"
	},
	"keywords": [],
	"author": "Beomsu Koh",
	"license": "MIT",
	"packageManager": "pnpm@10.32.1",
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/js": "10.0.1",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.6.5",
		"@typescript-eslint/utils": "^8.72.0",
		"builtin-modules": "5.4.0",
		"esbuild": "0.28.2",
		"eslint": "^10.13.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "17.13.0",
		"husky": "^9.1.7",
		"jiti": "2.7.0",
		"jsdom": "^30.1.3",
		"lint-staged": "^17.6.0",
		"obsidian": "latest",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"lint-staged": {
		"src/**/*.ts": [
			"eslint --fix"
		]
	}
}
